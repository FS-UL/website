---
import { base, nav, SITE_NAME } from '../consts';
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="site-header__inner">
    <a class="site-title" href={`${base}/`}>{SITE_NAME}</a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <nav id="site-nav" aria-label="Main">
      <ul>
        {nav.map((n) => (
          <li><a href={n.external ? n.href : `${base}${n.href}`} aria-current={path === `${base}${n.href}` ? 'page' : undefined} target={n.external ? '_blank' : undefined} rel={n.external ? 'noopener' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--wp--preset--color--base);
    box-shadow: 0 1px 0 var(--wp--preset--color--accent-5);
    padding-inline: var(--wp--preset--spacing--50);
    transition: transform 0.3s ease;
  }
  /* Slides out of view while scrolling down, returns on scroll up (see script below). */
  .site-header.is-hidden { transform: translateY(-100%); }
  @media (prefers-reduced-motion: reduce) { .site-header { transition: none; } }

  .site-header__inner {
    max-width: var(--wide-size); margin-inline: auto;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding-block: var(--wp--preset--spacing--30);
    position: relative;
  }
  #site-nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 1.8rem; flex-wrap: wrap; justify-content: flex-end; }
  #site-nav a {
    font-family: var(--wp--preset--font-family--orbitron);
    font-size: var(--wp--preset--font-size--small);
    color: var(--wp--preset--color--contrast); text-decoration: none;
  }
  #site-nav a:hover, #site-nav a[aria-current] { color: var(--wp--preset--color--accent-2); }
  .nav-toggle { display: none; background: none; border: 0; color: var(--wp--preset--color--contrast); cursor: pointer; padding: 4px; }
  @media (max-width: 781px) {
    .nav-toggle { display: block; padding: 10px; margin: -6px; } /* 44px tap target, same visual position */
    #site-nav { display: none; position: absolute; top: 100%; left: calc(-1 * var(--wp--preset--spacing--50)); right: calc(-1 * var(--wp--preset--spacing--50)); background: var(--wp--preset--color--accent-3); padding: 1rem var(--wp--preset--spacing--50) 1.5rem; z-index: 20; }
    #site-nav:global(.is-open) { display: block; }
    #site-nav ul { flex-direction: column; align-items: flex-start; gap: 0.25rem; }
    #site-nav a { display: block; padding-block: 0.6rem; font-size: var(--wp--preset--font-size--medium); }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const toggle = header.querySelector<HTMLButtonElement>('.nav-toggle')!;
  const nav = document.getElementById('site-nav')!;

  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav.classList.toggle('is-open', !open);
    if (!open) header.classList.remove('is-hidden');
  });

  // Hide on scroll down, show on scroll up. The 6px threshold ignores jitter and trackpad bounce.
  let lastY = window.scrollY;
  function update() {
    const y = Math.max(window.scrollY, 0);
    const delta = y - lastY;
    const navOpen = toggle.getAttribute('aria-expanded') === 'true';
    if (y <= header.offsetHeight || navOpen) {
      header.classList.remove('is-hidden');
    } else if (delta > 6) {
      header.classList.add('is-hidden');
    } else if (delta < -6) {
      header.classList.remove('is-hidden');
    }
    if (Math.abs(delta) > 6 || y <= header.offsetHeight) lastY = y;
  }
  window.addEventListener('scroll', update, { passive: true });
  // Keyboard users tabbing into the header should never land on a hidden one.
  header.addEventListener('focusin', () => header.classList.remove('is-hidden'));
</script>
