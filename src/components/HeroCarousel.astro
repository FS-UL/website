---
// Home page hero carousel. The default slot is the first slide (the main hero);
// `slides` are extra highlights (events, featured posts) that follow it.
// With no extra slides it renders the hero alone, with no controls.
import Cover from "./Cover.astro";
import Eyebrow from "./Eyebrow.astro";
import Button from "./Button.astro";
import type { Slide } from "../lib/highlights";

interface Props {
    slides?: Slide[];
}
const { slides = [] } = Astro.props;
const total = slides.length + 1;
const hasMany = total > 1;
const external = (href: string) => /^https?:\/\//.test(href);
---

<section
    class="carousel"
    aria-roledescription="carousel"
    aria-label="Highlights"
    data-carousel={hasMany ? "" : undefined}
>
    <div class="carousel__track">
        <div class="carousel__slide is-active" role="group" aria-roledescription="slide" aria-label={`1 of ${total}`}>
            <slot />
        </div>
        {
            slides.map((slide, i) => (
                <div
                    class="carousel__slide"
                    role="group"
                    aria-roledescription="slide"
                    aria-label={`${i + 2} of ${total}`}
                >
                    <Cover minHeight={664} tint="accent-3" inset image={slide.image}>
                        <Eyebrow>{slide.kind}</Eyebrow>
                        <h2 class="slide-title">{slide.title}</h2>
                        {slide.meta && <p class="slide-meta has-large-font-size">{slide.meta}</p>}
                        {slide.text && <p class="slide-text">{slide.text}</p>}
                        {slide.href && (
                            <div>
                                <Button href={slide.href} external={external(slide.href)}>
                                    {slide.cta}
                                </Button>
                            </div>
                        )}
                    </Cover>
                </div>
            ))
        }
    </div>

    {
        hasMany && (
            <div class="carousel__controls">
                <div class="carousel__controls-inner">
                    <button type="button" class="carousel__btn" data-prev aria-label="Previous slide">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
                    </button>
                    <div class="carousel__dots">
                        {Array.from({ length: total }, (_, i) => (
                            <button
                                type="button"
                                class="carousel__dot"
                                data-dot={i}
                                aria-label={`Go to slide ${i + 1}`}
                                aria-current={i === 0 ? "true" : "false"}
                            />
                        ))}
                    </div>
                    <button type="button" class="carousel__btn" data-next aria-label="Next slide">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
                    </button>
                    <button type="button" class="carousel__btn" data-toggle aria-label="Pause automatic slide show">
                        <svg viewBox="0 0 24 24" aria-hidden="true" data-pause><path d="M9 6v12M15 6v12" /></svg>
                        <svg viewBox="0 0 24 24" aria-hidden="true" data-play hidden><path d="M8 5l11 7-11 7z" /></svg>
                    </button>
                </div>
            </div>
        )
    }
</section>

<style>
    .carousel {
        position: relative;
    }

    /* Slides share one grid cell and crossfade; the cell is as tall as the tallest slide, so nothing jumps. */
    .carousel__track {
        display: grid;
    }
    .carousel__slide {
        grid-area: 1 / 1;
        min-width: 0;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.7s ease, visibility 0s linear 0.7s;
    }
    .carousel__slide.is-active {
        opacity: 1;
        visibility: visible;
        transition: opacity 0.7s ease, visibility 0s;
    }
    @media (prefers-reduced-motion: reduce) {
        .carousel__slide,
        .carousel__slide.is-active { transition: none; }
    }
    /* leave room for the controls at the bottom of each slide */
    .carousel[data-carousel] .carousel__slide :global(.cover) {
        padding-bottom: 5.5rem;
    }

    .slide-title {
        font-size: clamp(2rem, 5vw, 4rem);
        line-height: 1.1;
        color: var(--wp--preset--color--contrast);
    }
    @media (max-width: 781px) {
        .slide-title { font-size: clamp(1.75rem, 8vw, 4rem); }
    }
    .slide-meta { color: var(--wp--preset--color--accent-2); }
    .slide-text { color: var(--wp--preset--color--contrast); }

    /* Controls reuse the team-card flip button look: round accent-2 buttons with dark rounded-stroke icons. */
    .carousel__controls {
        position: absolute;
        inset-inline: 0;
        bottom: 1.5rem;
        padding-inline: var(--wp--preset--spacing--50);
        pointer-events: none;
    }
    .carousel__controls-inner {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        max-width: var(--wide-size);
        margin-inline: auto;
    }
    .carousel__controls-inner > * { pointer-events: auto; }
    .carousel__btn {
        display: grid;
        place-items: center;
        flex: none;
        width: 40px;
        height: 40px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background-color: var(--wp--preset--color--accent-2);
        color: var(--wp--preset--color--base);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.45);
        cursor: pointer;
        transition: transform 0.3s ease;
    }
    .carousel__btn svg {
        width: 22px;
        height: 22px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2.6;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .carousel__btn svg[data-play] { fill: currentColor; }
    /* the browser's [hidden] rule only covers HTML elements, not SVG */
    .carousel__btn svg[hidden] { display: none; }
    .carousel__btn:hover { transform: scale(1.1); }
    .carousel__btn:focus-visible,
    .carousel__dot:focus-visible {
        outline: 3px solid var(--wp--preset--color--contrast);
        outline-offset: 3px;
    }

    .carousel__dots {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding-inline: 0.25rem;
    }
    .carousel__dot {
        width: 12px;
        height: 12px;
        padding: 0;
        border: 0;
        border-radius: 6px;
        background-color: color-mix(in srgb, var(--wp--preset--color--contrast) 55%, transparent);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.45);
        cursor: pointer;
        transition: width 0.3s ease, background-color 0.3s ease;
    }
    .carousel__dot:hover { background-color: var(--wp--preset--color--contrast); }
    /* Touch screens: keep the dots small to look at but give each a 24px tap area. */
    @media (pointer: coarse) {
        .carousel__dots { gap: 0.75rem; }
        .carousel__dot { position: relative; }
        .carousel__dot::after { content: ""; position: absolute; inset: -6px; }
    }
    .carousel__dot[aria-current="true"] {
        width: 28px;
        background-color: var(--wp--preset--color--accent-2);
    }
</style>

<script>
    const AUTOPLAY_MS = 7000;
    const SWIPE_PX = 50;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
        const track = root.querySelector<HTMLElement>(".carousel__track")!;
        const slides = [...root.querySelectorAll<HTMLElement>(".carousel__slide")];
        const dots = [...root.querySelectorAll<HTMLElement>("[data-dot]")];
        const toggle = root.querySelector<HTMLElement>("[data-toggle]")!;
        const pauseIcon = toggle.querySelector<SVGElement>("[data-pause]")!;
        const playIcon = toggle.querySelector<SVGElement>("[data-play]")!;
        let index = 0;
        let playing = !reducedMotion.matches;
        let hovering = false;
        let timer: number | undefined;

        const schedule = () => {
            window.clearInterval(timer);
            if (playing && !hovering) timer = window.setInterval(() => show(index + 1), AUTOPLAY_MS);
        };

        // Slides are hidden with visibility, so inactive ones are out of the tab order and away from screen readers.
        const show = (i: number) => {
            index = (i + slides.length) % slides.length;
            slides.forEach((s, n) => s.classList.toggle("is-active", n === index));
            dots.forEach((d, n) => d.setAttribute("aria-current", String(n === index)));
            schedule(); // restart the timer so a manual change gets a full interval
        };

        const render = () => {
            pauseIcon.toggleAttribute("hidden", !playing);
            playIcon.toggleAttribute("hidden", playing);
            toggle.setAttribute("aria-label", playing ? "Pause automatic slide show" : "Start automatic slide show");
            // Only announce slide changes when the user is in control of them.
            track.setAttribute("aria-live", playing ? "off" : "polite");
            schedule();
        };

        root.querySelector("[data-prev]")!.addEventListener("click", () => show(index - 1));
        root.querySelector("[data-next]")!.addEventListener("click", () => show(index + 1));
        dots.forEach((d, n) => d.addEventListener("click", () => show(n)));
        toggle.addEventListener("click", () => { playing = !playing; render(); });

        // Pause while the pointer or keyboard focus is inside the carousel.
        root.addEventListener("mouseenter", () => { hovering = true; schedule(); });
        root.addEventListener("mouseleave", () => { hovering = false; schedule(); });
        root.addEventListener("focusin", () => { hovering = true; schedule(); });
        root.addEventListener("focusout", () => { hovering = false; schedule(); });

        // Swipe on touch screens.
        let startX = 0;
        track.addEventListener("touchstart", (e) => { startX = e.touches[0].clientX; }, { passive: true });
        track.addEventListener("touchend", (e) => {
            const dx = e.changedTouches[0].clientX - startX;
            if (Math.abs(dx) > SWIPE_PX) show(index + (dx < 0 ? 1 : -1));
        }, { passive: true });

        reducedMotion.addEventListener("change", () => { playing = !reducedMotion.matches; render(); });
        render();
    });
</script>
