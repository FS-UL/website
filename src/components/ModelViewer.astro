---
// Interactive 3D model (Google <model-viewer>). The .glb is large, so it only downloads
// when the visitor clicks the poster. Put the file in public/models/.
import { Image } from "astro:assets";
import { base } from "../consts";
import { photos } from "../lib/images";

interface Props {
    /** File name inside public/models/. */
    model?: string;
    alt?: string;
    poster?: ImageMetadata;
    /** Shown on the load button, e.g. "20 MB". */
    size?: string;
}
const {
    model = "car.glb",
    alt = "Interactive 3D model of the Formula Student UL car",
    poster = photos.carShowcase,
    size = "20 MB",
} = Astro.props;
---

<div class="model">
    <div class="model__stage">
        <model-viewer
            data-src={`${base}/models/${model}`}
            alt={alt}
            camera-controls
            touch-action="pan-y"
            auto-rotate
            shadow-intensity="1.2"
            shadow-softness="0.8"
            environment-image={`${base}/models/studio.png`}
            tone-mapping="agx"
            exposure="2"
        ></model-viewer>
        <button type="button" class="model__poster">
            <Image
                src={poster}
                alt=""
                class="model__poster-image"
                width={Math.min(1600, poster.width)}
                format="webp"
                quality={75}
            />
            <span class="model__load">View in 3D <small>({size})</small></span>
        </button>
    </div>
    <p class="model__hint">Drag to rotate · scroll or pinch to zoom</p>
</div>

<script>
    import "@google/model-viewer";

    document.querySelectorAll<HTMLElement>(".model").forEach((root) => {
        const viewer = root.querySelector("model-viewer") as HTMLElement & { src: string };
        const poster = root.querySelector<HTMLButtonElement>(".model__poster")!;
        const label = poster.querySelector<HTMLElement>(".model__load")!;
        poster.addEventListener("click", () => {
            if (poster.disabled) return;
            poster.disabled = true;
            label.textContent = "Loading…";
            viewer.src = viewer.dataset.src!;
        });
        viewer.addEventListener("load", () => { poster.hidden = true; });
        viewer.addEventListener("error", () => {
            poster.disabled = false;
            label.textContent = "Couldn't load the model. Try again";
        });
    });

    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.querySelectorAll("model-viewer").forEach((el) => el.removeAttribute("auto-rotate"));
    }
</script>

<style>
    .model { width: 100%; }
    .model__stage { position: relative; }
    model-viewer {
        display: block;
        width: 100%;
        height: clamp(320px, 60vw, 640px);
        --progress-bar-color: var(--wp--preset--color--accent-2);
        background-color: var(--wp--preset--color--accent-5);
        border-radius: 4px;
        overflow: hidden;
    }
    .model__poster {
        position: absolute;
        inset: 0;
        padding: 0;
        border: 0;
        border-radius: 4px;
        overflow: hidden;
        background: none;
        cursor: pointer;
    }
    .model__poster[hidden] { display: none; }
    .model__poster:disabled { cursor: progress; }
    .model__poster-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(0.55);
    }
    .model__load {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4em;
        font-family: var(--wp--preset--font-family--orbitron);
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--wp--preset--color--contrast);
    }
    .model__load small { font-size: var(--wp--preset--font-size--small); color: var(--wp--preset--color--accent-4); letter-spacing: 1px; }
    .model__hint {
        margin-block: var(--wp--preset--spacing--20) 0;
        text-align: center;
        font-size: var(--wp--preset--font-size--small);
        color: var(--wp--preset--color--accent-4);
    }
</style>
