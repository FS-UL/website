---
import { getCollection } from 'astro:content';
import { base } from '../consts';
import PostMeta from './PostMeta.astro';

// Replaces the WordPress "News Posts" query block: newest first, 9 per page.
const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 9);

function excerpt(entry: (typeof posts)[number]) {
  if (entry.data.excerpt) return entry.data.excerpt;
  const words = (entry.body ?? '')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
    .replace(/^#+\s*/gm, '')
    .replace(/[*_`]/g, '')
    .replace(/\s+/g, ' ')
    .trim()
    .split(' ');
  return words.slice(0, 25).join(' ') + (words.length > 25 ? '…' : '');
}
---
<div class="wp-block-query">
  <div class="wp-block-post-template is-layout-grid" style="--block-gap:var(--wp--preset--spacing--40);grid-template-columns:repeat(auto-fill,minmax(min(18rem,100%),1fr))">
    {posts.map((post) => (
      <div class="wp-block-group has-accent-5-background-color has-background news-card is-layout-constrained">
        <div class="news-card__body">
          <PostMeta date={post.data.date} author={post.data.author} />
          <h3 class="wp-block-heading has-contrast-color has-text-color has-large-font-size"><a href={`${base}/${post.id}/`}>{post.data.title}</a></h3>
          <p class="has-contrast-color has-text-color has-small-font-size">{excerpt(post)}</p>
        </div>
      </div>
    ))}
  </div>
</div>
