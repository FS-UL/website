---
import type { CollectionEntry } from 'astro:content';
import { base } from '../consts';
import PostMeta from './PostMeta.astro';
import { postExcerpt } from '../lib/posts';

// Replaces the WordPress "News Posts" query block. The newsroom page passes in the (already sorted, paginated) posts.
interface Props { posts: CollectionEntry<'posts'>[] }
const { posts } = Astro.props;

---
<div class="news-grid">
  {posts.map((post) => (
    <div class="news-card">
      <div class="news-card__body">
        <PostMeta date={post.data.date} author={post.data.author} />
        <h3><a href={`${base}/${post.id}/`}>{post.data.title}</a></h3>
        <p>{postExcerpt(post)}</p>
      </div>
    </div>
  ))}
</div>

<style>
  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    gap: var(--wp--preset--spacing--40);
    max-width: var(--wide-size);
    margin-inline: auto;
  }
  .news-card { background-color: var(--wp--preset--color--accent-5); }
  h3 { color: var(--wp--preset--color--contrast); }
  p { color: var(--wp--preset--color--contrast); font-size: var(--wp--preset--font-size--small); }
</style>
