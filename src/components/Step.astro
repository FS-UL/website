---
// A numbered step with a short description, for use inside <Columns>.
interface Props {
    number: string;
    title: string;
}
const { number, title } = Astro.props;
---

<div class="step">
    <p class="step__number">{number}</p>
    <h3>{title}</h3>
    <p class="step__text"><slot /></p>
</div>

<style>
    .step { flex: 1 1 0; min-width: 0; overflow-wrap: break-word; }
    .step > * + * { margin-block-start: var(--block-gap); }
    /* Looks like a heading, but a bare number is not one. */
    .step__number {
        font-family: var(--wp--preset--font-family--orbitron);
        font-size: var(--wp--preset--font-size--large);
        font-weight: 700;
        letter-spacing: 2px;
        line-height: 1.23;
        color: var(--wp--preset--color--accent-2);
    }
    h3 { font-size: 1em; color: var(--wp--preset--color--contrast); }
    .step__text { font-size: var(--wp--preset--font-size--small); color: var(--wp--preset--color--contrast); }
</style>
