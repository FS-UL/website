---
import NewsGrid from './NewsGrid.astro';
import { withBase } from '../lib.js';
const { html } = Astro.props;
const MARKER = '<div data-news-list></div>';
const [before, after] = withBase(html).split(MARKER);
---
<Fragment set:html={before} />
{after !== undefined && <NewsGrid />}
{after !== undefined && <Fragment set:html={after} />}
