---
import "../styles/global.css";
import "../styles/flip-cards.css";
import { base, SITE_NAME, SITE_DESCRIPTION } from "../consts";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SEO } from "astro-seo";
import { getImage } from "astro:assets";
import { photos } from "../lib/images";
import barlow400 from "../assets/fonts/Barlow-400.woff2?url";
import orbitron700 from "../assets/fonts/Orbitron-700.woff2?url";
import orbitron900 from "../assets/fonts/Orbitron-900.woff2?url";
const {
    title,
    description = SITE_DESCRIPTION,
    type = "website",
    publishedTime,
    author,
    noindex = false,
    image = photos.carShowcase,
    prev,
    next,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = await getImage({
    src: image,
    width: 1200,
    height: 630,
    fit: "cover",
    format: "jpg",
    quality: 80,
});
const ogImage = new URL(og.src, Astro.site).href;
const jsonLd = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "Organization",
            "@id": new URL("/#org", Astro.site).href,
            name: SITE_NAME,
            url: new URL("/", Astro.site).href,
            logo: new URL(`${base}/favicon.png`, Astro.site).href,
            description: SITE_DESCRIPTION,
            sameAs: ["https://www.instagram.com/formulastudentul/"],
        },
        ...(type === "article"
            ? [
                  {
                      "@type": "BlogPosting",
                      headline: title,
                      description,
                      image: ogImage,
                      datePublished: publishedTime,
                      author: author
                          ? { "@type": "Person", name: author }
                          : undefined,
                      publisher: { "@id": new URL("/#org", Astro.site).href },
                      mainEntityOfPage: canonical,
                  },
              ]
            : []),
    ],
};
const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
---

<!doctype html>
<html lang="en-GB">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <SEO
            title={fullTitle}
            description={description}
            canonical={canonical}
            noindex={noindex}
            openGraph={{
                basic: {
                    title: fullTitle,
                    type,
                    image: ogImage,
                    url: canonical,
                },
                image: { width: 1200, height: 630 },
                optional: {
                    description,
                    locale: "en_GB",
                    siteName: SITE_NAME,
                },
                article:
                    type === "article" && publishedTime
                        ? { publishedTime }
                        : undefined,
            }}
            twitter={{
                card: "summary_large_image",
                title: fullTitle,
                description,
                image: ogImage,
            }}
        />
        <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
        <link
            rel="alternate"
            type="application/rss+xml"
            title={`${SITE_NAME} news`}
            href={`${base}/rss.xml`}
        />
        {prev && <link rel="prev" href={prev} />}
        {next && <link rel="next" href={next} />}
        <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
        <meta name="theme-color" content="#000000" />
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
        {[barlow400, orbitron700, orbitron900].map((href) => (
            <link
                rel="preload"
                href={href}
                as="font"
                type="font/woff2"
                crossorigin
            />
        ))}
    </head>
    <body>
        <Header />
        <main>
            <slot />
        </main>
        <Footer />
        <script>
            import "../scripts/flip-cards.js";
        </script>
    </body>
</html>
