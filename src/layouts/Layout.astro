---
import "../styles/global.css";
import "../styles/flip-cards.css";
import { base, SITE_NAME, SITE_DESCRIPTION, INSTAGRAM_URL } from "../consts";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SEO } from "astro-seo";
import { getImage } from "astro:assets";
import { photos } from "../lib/images";
import barlow400 from "../assets/fonts/Barlow-400.woff2?url";
import orbitron700 from "../assets/fonts/Orbitron-700.woff2?url";
import orbitron900 from "../assets/fonts/Orbitron-900.woff2?url";
interface Props {
    /** Page title; the site name is appended. Leave out on the home page. */
    title?: string;
    description?: string;
    type?: "website" | "article";
    /** ISO date, for articles. */
    publishedTime?: string;
    author?: string;
    noindex?: boolean;
    /** Social preview image (cropped to 1200x630). */
    image?: ImageMetadata;
    imageAlt?: string;
    /** Absolute URLs of the previous/next page in a paginated list. */
    prev?: string;
    next?: string;
}
const {
    title,
    description = SITE_DESCRIPTION,
    type = "website",
    publishedTime,
    author,
    noindex = false,
    image = photos.carShowcase,
    imageAlt = `${SITE_NAME} team and car`,
    prev,
    next,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = await getImage({
    src: image,
    width: 1200,
    height: 630,
    fit: "cover",
    format: "jpg",
    quality: 80,
});
const ogImage = new URL(og.src, Astro.site).href;
const homeUrl = new URL(`${base}/`, Astro.site).href;
const isHome = canonical === homeUrl;
const orgId = `${homeUrl}#org`;
const crumbs = isHome || noindex
    ? []
    : [
          { name: SITE_NAME, url: homeUrl },
          ...(type === "article"
              ? [{ name: "Newsroom", url: new URL(`${base}/newsroom/`, Astro.site).href }]
              : []),
          { name: title, url: canonical },
      ];
const jsonLd = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "Organization",
            "@id": orgId,
            name: SITE_NAME,
            url: homeUrl,
            logo: new URL(`${base}/favicon.png`, Astro.site).href,
            description: SITE_DESCRIPTION,
            parentOrganization: { "@type": "CollegeOrUniversity", name: "University of Limerick" },
            sameAs: [INSTAGRAM_URL],
        },
        {
            "@type": "WebSite",
            "@id": `${homeUrl}#website`,
            name: SITE_NAME,
            url: homeUrl,
            description: SITE_DESCRIPTION,
            inLanguage: "en-GB",
            publisher: { "@id": orgId },
        },
        ...(crumbs.length
            ? [
                  {
                      "@type": "BreadcrumbList",
                      itemListElement: crumbs.map((c, i) => ({
                          "@type": "ListItem",
                          position: i + 1,
                          name: c.name,
                          item: c.url,
                      })),
                  },
              ]
            : []),
        ...(type === "article"
            ? [
                  {
                      "@type": "BlogPosting",
                      headline: title,
                      description,
                      image: ogImage,
                      datePublished: publishedTime,
                      author: author
                          ? { "@type": "Person", name: author }
                          : undefined,
                      publisher: { "@id": orgId },
                      mainEntityOfPage: canonical,
                  },
              ]
            : []),
    ],
};
const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
---

<!doctype html>
<html lang="en-GB">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <SEO
            title={fullTitle}
            description={description}
            canonical={canonical}
            noindex={noindex}
            openGraph={{
                basic: {
                    title: fullTitle,
                    type,
                    image: ogImage,
                    url: canonical,
                },
                image: { width: 1200, height: 630, alt: imageAlt },
                optional: {
                    description,
                    locale: "en_GB",
                    siteName: SITE_NAME,
                },
                article:
                    type === "article" && publishedTime
                        ? { publishedTime }
                        : undefined,
            }}
            twitter={{
                card: "summary_large_image",
                title: fullTitle,
                description,
                image: ogImage,
                imageAlt,
            }}
        />
        <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
        <link
            rel="alternate"
            type="application/rss+xml"
            title={`${SITE_NAME} news`}
            href={`${base}/rss.xml`}
        />
        {prev && <link rel="prev" href={prev} />}
        {next && <link rel="next" href={next} />}
        <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
        <meta name="theme-color" content="#292929" />
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
        {[barlow400, orbitron700, orbitron900].map((href) => (
            <link
                rel="preload"
                href={href}
                as="font"
                type="font/woff2"
                crossorigin
            />
        ))}
    </head>
    <body>
        <Header />
        <main>
            <slot />
        </main>
        <Footer />
        <script>
            import "../scripts/flip-cards.js";
        </script>
    </body>
</html>
