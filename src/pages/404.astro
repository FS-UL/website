---
import Layout from "../layouts/Layout.astro";
import Band from "../components/Band.astro";
import { base } from "../consts";
---

<Layout title="Page not found" noindex>
    <Band size={800}>
        <h1>404</h1>
        <p>
            Looks like this lap ended in the gravel. The page you're after
            doesn't exist or has moved.
        </p>
        <p>
            <a href={`${base}/`}>Back to the homepage</a> ·{" "}
            <a href={`${base}/newsroom/`}>Newsroom</a>
        </p>
    </Band>
</Layout>

<style>
    h1, p { text-align: center; }
</style>
