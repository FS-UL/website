---
import Layout from "../layouts/Layout.astro";
import Cover from "../components/Cover.astro";
import Band from "../components/Band.astro";
import Columns from "../components/Columns.astro";
import Stat from "../components/Stat.astro";
import Eyebrow from "../components/Eyebrow.astro";
import CardGrid from "../components/CardGrid.astro";
import Card from "../components/Card.astro";
import CtaCover from "../components/CtaCover.astro";
import Buttons from "../components/Buttons.astro";
import Button from "../components/Button.astro";
import HeroCarousel from "../components/HeroCarousel.astro";
import { base } from "../consts";
import { getHighlights } from "../lib/highlights";
import { photos } from "../lib/images";

const highlights = await getHighlights();
---

<Layout>
    <HeroCarousel slides={highlights}>
        <Cover minHeight={664} tint="accent-3" inset eager image={photos.teamSilverstone}>
            <h1 class="hero-title">
                Built in Limerick.
                <br />
                Engineered to <span>Perform.</span>
            </h1>
            <p class="has-large-font-size">This site is still under construction 🏗️</p>
            <Buttons>
                <Button href={`${base}/ourcar/`} textColor="accent-1">See our car</Button>
                <Button href={`${base}/meettheteam/`} variant="outline">Meet the team</Button>
            </Buttons>
        </Cover>
    </HeroCarousel>

    <Band bg="accent-5">
        <Columns>
            <Stat big value="70+" label="Students" />
            <Stat big value="10" label="Disciplines" />
            <Stat big value="00" label="Partners" />
        </Columns>
    </Band>

    <Band bg="base">
        <h2 class="section-title section-title--accent">Our Mission</h2>
        <p>
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Quisque at
            neque mattis, malesuada velit vel, facilisis tortor. Phasellus vel
            iaculis dui. In libero ipsum, convallis vitae tellus nec, posuere
            mollis turpis.
        </p>
    </Band>

    <Band bg="accent-3" pad={50}>
        <Eyebrow>Explore</Eyebrow>
        <h2 class="section-title">Everything Formula Student UL</h2>
        <CardGrid>
            <Card title="Our Car" href={`${base}/ourcar/`} linkText="See the car →">
                The engineering behind this year's race car.
            </Card>
            <Card title="Meet the Team" href={`${base}/meettheteam/`} linkText="Meet everyone →">
                The students who make it all happen.
            </Card>
            <Card title="Newsroom" href={`${base}/newsroom/`} linkText="Read the news →">
                Updates from the track and the workshop.
            </Card>
            <Card title="Our Partners" href={`${base}/ourpartners/`} linkText="See partners →">
                The sponsors who help us get on the grid.
            </Card>
        </CardGrid>
    </Band>

    <CtaCover
        image={photos.carOnGrid}
        position="50% 22%"
        title="Want to back the team?"
        text="Partner with Formula Student UL and help put the next generation of engineers on the grid."
    >
        <Buttons>
            <Button href={`${base}/sponsor/`}>Become a partner</Button>
            <Button href={`${base}/meettheteam/`} variant="outline">Meet the team</Button>
        </Buttons>
    </CtaCover>
</Layout>

<style>
    .hero-title {
        font-size: 5rem;
        font-style: normal;
        font-weight: 1000;
        line-height: 1;
        color: var(--wp--preset--color--contrast);
    }
    .hero-title span { color: var(--wp--preset--color--accent-2); }
    @media (max-width: 781px) {
        .hero-title { font-size: clamp(2rem, 11vw, 5rem); }
    }
</style>
