---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { base } from '../consts';
import img0 from '../assets/uploads/2026/09/cHJpdmF0ZS9zdGF0aWMvaW1hZ2Uvd2Vic2l0ZS8yMDIyLTA0L2xyL2ZyY2FyX3JhY2luZ19iYXJjZWxvbmFfZm9ybXVsYV8zLWltYWdlLWt6MmR5Nms4LmpwZw.webp';
---
<Layout>
<div class="wp-block-cover alignfull is-dark" style="padding-right:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50);min-height:664px"><Image src={img0} alt="" class="wp-block-cover__image-background" style="object-position:29% 63%" width={1920} format="webp" quality={80} loading="eager" /><span aria-hidden="true" class="wp-block-cover__background has-accent-3-background-color has-background-dim-80 has-background-dim"></span><div class="wp-block-cover__inner-container"><h1 class="wp-block-heading alignwide has-contrast-color has-text-color" style="font-size:5rem;font-style:normal;font-weight:1000;line-height:1">Built in Limerick.<br>Engineered to <span style="color:#00b140">Perform.</span></h1>
<p class="alignwide has-contrast-color has-text-color has-large-font-size">Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
<div class="wp-block-buttons alignwide is-layout-flex" style="flex-wrap:wrap"><div class="wp-block-button"><a class="wp-block-button__link has-accent-1-color has-accent-2-background-color has-text-color has-background wp-element-button" href={`${base}/our-car/`} style="font-style:normal;font-weight:700">See our car</a></div>
<div class="wp-block-button is-style-outline"><a class="wp-block-button__link has-contrast-color has-text-color wp-element-button" href={`${base}/meet-the-team/`} style="font-style:normal;font-weight:700">Meet the team</a></div>
</div>
</div></div>
<div class="wp-block-group alignfull has-accent-5-background-color has-background is-layout-constrained" style="margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--60);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--60);padding-left:var(--wp--preset--spacing--50);--content-size:1200px"><div class="wp-block-columns alignwide is-layout-flex"><div class="wp-block-column"><h3 class="wp-block-heading has-accent-2-color has-text-color" style="font-size:clamp(2.25rem, 5vw, 4.5rem);line-height:1">70+</h3>
<p class="has-contrast-color has-text-color has-orbitron-font-family has-medium-font-size" style="letter-spacing:2px;text-transform:uppercase">Students</p>
</div>
<div class="wp-block-column"><h3 class="wp-block-heading has-accent-2-color has-text-color" style="font-size:clamp(2.25rem, 5vw, 4.5rem);line-height:1">10</h3>
<p class="has-contrast-color has-text-color has-orbitron-font-family has-medium-font-size" style="letter-spacing:2px;text-transform:uppercase">Disciplines</p>
</div>
<div class="wp-block-column"><h3 class="wp-block-heading has-accent-2-color has-text-color" style="font-size:clamp(2.25rem, 5vw, 4.5rem);line-height:1">00</h3>
<p class="has-contrast-color has-text-color has-orbitron-font-family has-medium-font-size" style="letter-spacing:2px;text-transform:uppercase">Partners</p>
</div>
</div>
</div>
<div class="wp-block-group alignfull has-base-background-color has-background is-layout-constrained" style="margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--60);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--60);padding-left:var(--wp--preset--spacing--50);--content-size:1200px"><h1 class="wp-block-heading alignwide has-accent-2-color has-text-color">Our Mission</h1>
<p class="alignwide has-contrast-color has-text-color has-medium-font-size">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Quisque at neque mattis, malesuada velit vel, facilisis tortor. Phasellus vel iaculis dui. In libero ipsum, convallis vitae tellus nec, posuere mollis turpis.</p>
</div>
<div class="wp-block-group alignfull has-accent-3-background-color has-background is-layout-constrained" style="margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50);--content-size:1200px"><p class="has-accent-2-color has-text-color has-small-font-size" style="font-style:normal;font-weight:700;letter-spacing:2px;text-transform:uppercase">Explore</p>
<h2 class="wp-block-heading has-contrast-color has-text-color has-xx-large-font-size">Everything Formula Student UL</h2>
<div class="wp-block-group is-layout-grid" style="grid-template-columns:repeat(auto-fill,minmax(min(16rem,100%),1fr));--block-gap:var(--wp--preset--spacing--40)"><div class="wp-block-group has-contrast-color has-accent-5-background-color has-text-color has-background is-layout-constrained" style="border-radius:12px;padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--40);--block-gap:var(--wp--preset--spacing--20)"><h3 class="wp-block-heading has-contrast-color has-text-color">Our Car</h3>
<p class="has-contrast-color has-text-color">The engineering behind this year's race car.</p>
<p style="font-weight:700"><a href={`${base}/our-car/`}>See the car →</a></p>
</div>
<div class="wp-block-group has-contrast-color has-accent-5-background-color has-text-color has-background is-layout-constrained" style="border-radius:12px;padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--40);--block-gap:var(--wp--preset--spacing--20)"><h3 class="wp-block-heading has-contrast-color has-text-color">Meet the Team</h3>
<p class="has-contrast-color has-text-color">The students who make it all happen.</p>
<p style="font-weight:700"><a href={`${base}/meet-the-team/`}>Meet everyone →</a></p>
</div>
<div class="wp-block-group has-contrast-color has-accent-5-background-color has-text-color has-background is-layout-constrained" style="border-radius:12px;padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--40);--block-gap:var(--wp--preset--spacing--20)"><h3 class="wp-block-heading has-contrast-color has-text-color">Newsroom</h3>
<p class="has-contrast-color has-text-color">Updates from the track and the workshop.</p>
<p style="font-weight:700"><a href={`${base}/newsroom/`}>Read the news →</a></p>
</div>
<div class="wp-block-group has-contrast-color has-accent-5-background-color has-text-color has-background is-layout-constrained" style="border-radius:12px;padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--40);--block-gap:var(--wp--preset--spacing--20)"><h3 class="wp-block-heading has-contrast-color has-text-color">Our Partners</h3>
<p class="has-contrast-color has-text-color">The sponsors who help us get on the grid.</p>
<p style="font-weight:700"><a href={`${base}/ourpartners/`}>See partners →</a></p>
</div>
</div>
</div>
<div class="wp-block-cover alignfull is-dark" style="margin-top:0;margin-bottom:0;padding-top:0;padding-right:var(--wp--preset--spacing--50);padding-bottom:0;padding-left:var(--wp--preset--spacing--50);min-height:360px"><Image src={img0} alt="" class="wp-block-cover__image-background wp-image-80" style="object-position:29% 63%" width={1920} format="webp" quality={80} loading="eager" /><span aria-hidden="true" class="wp-block-cover__background has-base-background-color has-background-dim-80 has-background-dim"></span><div class="wp-block-cover__inner-container"><h2 class="wp-block-heading alignwide has-contrast-color has-text-color has-xx-large-font-size">Want to back the team?</h2>
<p class="alignwide has-contrast-color has-text-color has-large-font-size">Partner with Formula Student UL and help put the next generation of engineers on the grid.</p>
<div class="wp-block-buttons alignwide is-layout-flex" style="flex-wrap:wrap"><div class="wp-block-button"><a class="wp-block-button__link has-base-color has-accent-2-background-color has-text-color has-background wp-element-button" href={`${base}/ourpartners/`} style="font-style:normal;font-weight:700">Become a partner</a></div>
<div class="wp-block-button is-style-outline"><a class="wp-block-button__link has-contrast-color has-text-color wp-element-button" href={`${base}/meet-the-team/`} style="font-style:normal;font-weight:700">Meet the team</a></div>
</div>
</div></div>
</Layout>
