---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import NewsGrid from '../components/NewsGrid.astro';
import { base } from '../consts';
import img0 from '../assets/team-silverstone.png';
---
<Layout title="Newsroom">
<div class="wp-block-cover alignfull" style="min-height:166px"><Image src={img0} alt="" class="wp-block-cover__image-background wp-image-80 size-full" style="object-position:50% 60%" width={1920} format="webp" quality={80} loading="lazy" /><span aria-hidden="true" class="wp-block-cover__background has-base-background-color has-background-dim-80 has-background-dim"></span><div class="wp-block-cover__inner-container"><h1 class="wp-block-heading has-text-align-left alignwide has-contrast-color has-text-color has-link-color" style="font-size:5rem">Newsroom</h1>
</div></div>
<div class="wp-block-group alignfull has-accent-5-background-color has-background is-layout-constrained" style="margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50);--content-size:800px;--block-gap:var(--wp--preset--spacing--30)"><h2 class="wp-block-heading has-text-align-left alignwide has-accent-2-color has-text-color has-xx-large-font-size">Latest from the team</h2>
<p class="has-text-align-left alignwide has-contrast-color has-text-color has-medium-font-size">Race updates, build progress and stories from Formula Student UL, all in one place.</p>
</div>
<div class="wp-block-group alignfull has-base-background-color has-background is-layout-constrained" style="margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--60);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--60);padding-left:var(--wp--preset--spacing--50);--content-size:1200px;--block-gap:var(--wp--preset--spacing--30)"><NewsGrid /></div>
<div class="wp-block-cover alignfull is-dark" style="padding-right:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50);min-height:360px"><Image src={img0} alt="" class="wp-block-cover__image-background wp-image-80" style="object-position:50% 60%" width={1920} format="webp" quality={80} loading="lazy" /><span aria-hidden="true" class="wp-block-cover__background has-base-background-color has-background-dim-80 has-background-dim"></span><div class="wp-block-cover__inner-container"><h2 class="wp-block-heading alignwide has-contrast-color has-text-color has-xx-large-font-size">Follow the build</h2>
<p class="has-contrast-color has-text-color has-large-font-size">Behind-the-scenes updates, workshop photos and race-day moments, straight from the team.</p>
<div class="wp-block-buttons is-layout-flex" style="flex-wrap:wrap"><div class="wp-block-button"><a class="wp-block-button__link has-base-color has-accent-2-background-color has-text-color has-background wp-element-button" href="https://www.instagram.com/formulastudentul/" style="font-style:normal;font-weight:700">Follow on Instagram</a></div>
<div class="wp-block-button is-style-outline"><a class="wp-block-button__link has-contrast-color has-text-color wp-element-button" href={`${base}/ourpartners/`} style="font-style:normal;font-weight:700">Back the team</a></div>
</div>
</div></div>
</Layout>
