---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Band from "../components/Band.astro";
import Columns from "../components/Columns.astro";
import Stat from "../components/Stat.astro";
import CardGrid from "../components/CardGrid.astro";
import Card from "../components/Card.astro";
import Eyebrow from "../components/Eyebrow.astro";
import ModelViewer from "../components/ModelViewer.astro";
import Step from "../components/Step.astro";
import CtaCover from "../components/CtaCover.astro";
import Buttons from "../components/Buttons.astro";
import Button from "../components/Button.astro";
import { base } from "../consts";
import { photos } from "../lib/images";

const systems = [
    ["01", "Powertrain"],
    ["02", "Chassis"],
    ["03", "Aerodynamics"],
    ["04", "Suspension"],
    ["05", "Electronics"],
    ["06", "Brakes"],
];
---

<Layout
    title="Our Car"
    description="Every part of our car is designed, built and tested by students at the University of Limerick."
>
    <PageHero
        title="Our Car"
        subtitle="Built in Limerick"
        lede="Every part of our car is designed, built and tested by students at the University of Limerick."
        minHeight={480}
        image={photos.carShowcase}
        position="50% 60%"
    />

    <Band bg="base">
        <h2 class="section-title">The Numbers</h2>
        <Columns>
            <Stat value="000" label="Power (kW)" />
            <Stat value="000" label="Weight (kg)" />
            <Stat value="0.0s" label="0 to 100 km/h" />
        </Columns>
    </Band>

    <Band bg="accent-5">
        <Eyebrow>Explore it</Eyebrow>
        <h2 class="section-title">See it from every angle</h2>
        <ModelViewer />
    </Band>

    <Band bg="accent-3">
        <h2 class="section-title">Six systems, one car</h2>
        <CardGrid>
            {
                systems.map(([number, title]) => (
                    <Card eyebrow={number} title={title}>
                        Lorem ipsum dolor sit amet, consectetur adipiscing elit.
                        Quisque at neque mattis, malesuada velit vel, facilisis
                        tortor.
                    </Card>
                ))
            }
        </CardGrid>
    </Band>

    <Band bg="base">
        <Eyebrow>How it comes together</Eyebrow>
        <h2 class="section-title">From sketch to start line</h2>
        <Columns>
            <Step number="01" title="Design">
                Concepts, simulation and analysis turn into a full CAD model of
                the car.
            </Step>
            <Step number="02" title="Build">
                Parts are manufactured and assembled by the team in the
                workshop.
            </Step>
            <Step number="03" title="Test & race">
                Shakedown, tuning and then competition against universities from
                around the world.
            </Step>
        </Columns>
    </Band>

    <CtaCover
        image={photos.pitlaneTeam}
        position="50% 72%"
        title="Want to know who builds it?"
        text="Behind every lap is a team of students from the University of Limerick, supported by our partners."
    >
        <Buttons>
            <Button href={`${base}/meettheteam/`}>Meet the team</Button>
            <Button href={`${base}/ourpartners/`} variant="outline">Our partners</Button>
        </Buttons>
    </CtaCover>
</Layout>
