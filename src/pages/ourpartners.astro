---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import PageHero from "../components/PageHero.astro";
import Band from "../components/Band.astro";
import CardGrid from "../components/CardGrid.astro";
import Card from "../components/Card.astro";
import CtaCover from "../components/CtaCover.astro";
import Buttons from "../components/Buttons.astro";
import Button from "../components/Button.astro";
import { base } from "../consts";
import { photos } from "../lib/images";
import img1 from "../assets/uploads/2026/09/Irish-Cement-Logo.png";
import img2 from "../assets/uploads/2026/09/Serosep-edited.png";
import img3 from "../assets/uploads/2026/09/Onsemi_logo_2021.svg_.webp";

const logos = [
    { src: img1, width: 763, alt: "Irish Cement" },
    { src: img2, width: 1000, alt: "Serosep" },
    { src: img3, width: 1000, alt: "onsemi" },
];
const contact = `${base}/sponsor/`;
---

<Layout
    title="Our Partners"
    description="Formula Student UL wouldn't be on the track without the support of our partners. Their expertise, resources and belief in our team let us design, build and race a car of our own."
>
    <PageHero title="Our Partners" image={photos.garageMechanics} position="50% 55%" />

    <Band bg="base" pad={50} gap="var(--wp--preset--spacing--30)">
        <h2 class="section-title section-title--accent">Backed by industry leaders</h2>
        <p>
            Formula Student UL wouldn't be on the track without the support of
            our partners. Their expertise, resources and belief in our team let
            us design, build and race a car of our own.
        </p>
    </Band>

    <div class="logos">
        {
            logos.map(({ src, width, alt }) => (
                <figure>
                    <Image src={src} {alt} {width} format="webp" quality={80} />
                </figure>
            ))
        }
    </div>

    <Band size={800} gap="var(--wp--preset--spacing--30)">
        <h2 class="section-title section-title--accent section-title--small">Why partner with us</h2>
        <hr class="rule" />
        <p class="has-large-font-size">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Quisque at neque mattis, malesuada velit vel, facilisis tortor. Phasellus vel iaculis dui. In libero ipsum, convallis vitae tellus nec, posuere mollis turpis. Vivamus convallis tortor eros, vel suscipit nibh sollicitudin non. Maecenas id pretium magna, a varius ligula. Pellentesque congue neque ut erat fermentum posuere. Donec vel egestas enim, sed pellentesque tellus. Fusce ante ex, porttitor at mattis ac, fermentum eget arcu. Pellentesque habitant morbi tristique senectus et netus et malesuada fames ac turpis egestas. Nullam molestie sollicitudin eros sit amet fringilla. Fusce vitae eros ut leo tincidunt mollis. Nullam scelerisque leo at rhoncus dapibus. Vestibulum tristique finibus semper. Etiam faucibus gravida leo vel hendrerit. Proin non lacus bibendum purus condimentum maximus in non ligula. Duis euismod, sapien hendrerit pharetra sollicitudin, ipsum magna pharetra nisl, consectetur congue nisi neque at lorem.
        </p>
        <p class="has-large-font-size">
            Nulla interdum mauris metus, vitae pretium velit tempus vel. Suspendisse bibendum auctor ligula, ut vestibulum arcu tristique nec. Ut placerat erat convallis vehicula sodales. Quisque lobortis neque vel pretium facilisis. Donec id nulla tellus. Pellentesque massa felis, pulvinar bibendum auctor nec, sagittis eget quam. Quisque nunc lorem, venenatis at libero quis, auctor scelerisque mi. Duis interdum convallis ante, id convallis nisl hendrerit ac. Vestibulum placerat in magna et pharetra. Duis a euismod massa. Curabitur consequat malesuada nisi, nec pharetra ligula porttitor ut.
        </p>
        <p class="has-large-font-size">
            Nunc faucibus nisl in ultricies ultrices. Class aptent taciti sociosqu ad litora torquent per conubia nostra, per inceptos himenaeos. Vivamus in eros tempus, aliquam magna at, euismod mi. Donec consequat nisi ut iaculis venenatis. Pellentesque habitant morbi tristique senectus et netus et malesuada fames ac turpis egestas. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut viverra sem lacus, at aliquet est sollicitudin et. Aenean sed felis consequat justo convallis ultrices. Donec sit amet tristique ante. Proin a pharetra tellus, eget interdum justo. Aliquam erat volutpat. Duis et sollicitudin leo. In hac habitasse platea dictumst.
        </p>
    </Band>

    <Band bg="accent-3">
        <h2 class="section-title">Ways to partner</h2>
        <CardGrid>
            <Card title="Financial Support" href={contact} linkText="Get in touch →">
                Help cover the build, testing and travel costs of getting a car
                to competition.
            </Card>
            <Card title="Parts & Materials" href={contact} linkText="Get in touch →">
                Supply components, materials or manufacturing time that go
                straight onto the car.
            </Card>
            <Card title="Technical support" href={contact} linkText="Get in touch →">
                Share engineering knowledge, tooling and mentoring with our
                student team.
            </Card>
        </CardGrid>
    </Band>

    <CtaCover
        image={photos.carOnGrid}
        position="50% 90%"
        title="Ready to join the grid?"
        text="Talk to us about how your company can back the next generation of engineers."
    >
        <Buttons>
            <Button href={`${base}/meettheteam/`}>Meet the team</Button>
            <Button href={`${base}/ourcar/`} variant="outline">See our car</Button>
        </Buttons>
    </CtaCover>
</Layout>

<style>
    .logos {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        justify-content: center;
        gap: var(--wp--preset--spacing--60);
        padding: var(--wp--preset--spacing--60) var(--wp--preset--spacing--50);
        background-color: var(--wp--preset--color--accent-2);
    }
    .logos figure { margin: 0; }
    /* Phones: stack the logos at a readable size instead of squeezing them onto one line. */
    @media (max-width: 781px) {
        .logos { flex-wrap: wrap; gap: 1.5rem 2rem; }
        .logos figure { width: min(100%, 16rem); }
        .logos img { width: 100%; }
    }
    .logos img { vertical-align: bottom; max-width: 100%; height: auto; }
    .rule {
        color: var(--wp--preset--color--accent-2);
        border: 0;
        border-bottom: 1px solid var(--wp--preset--color--accent-2);
        background-color: var(--wp--preset--color--accent-2);
        margin-block: var(--wp--preset--spacing--40);
        max-width: var(--wide-size);
        margin-inline: auto;
    }
</style>
