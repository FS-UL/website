---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Band from "../components/Band.astro";
import CardGrid from "../components/CardGrid.astro";
import Card from "../components/Card.astro";
import Buttons from "../components/Buttons.astro";
import Button from "../components/Button.astro";
import { base, SPONSOR_FORM_URL } from "../consts";
---

<Layout
    title="Sponsor Enquiry"
    description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Quisque at neque mattis, malesuada velit vel."
>
    <PageHero title="Sponsor Enquiry" />

    <Band bg="base" gap="var(--wp--preset--spacing--30)">
        <h2 class="section-title section-title--accent">Lorem ipsum dolor sit amet</h2>
        <p class="has-large-font-size">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Quisque at
            neque mattis, malesuada velit vel, facilisis tortor. Phasellus vel
            iaculis dui.
        </p>
        <Buttons>
            <Button href={SPONSOR_FORM_URL} external>Open the enquiry form</Button>
            <Button href={`${base}/ourpartners/`} variant="outline">Our partners</Button>
        </Buttons>
    </Band>

    <Band bg="accent-3">
        <h2 class="section-title">Lorem ipsum</h2>
        <CardGrid>
            <Card eyebrow="01" title="Lorem ipsum">
                Lorem ipsum dolor sit amet, consectetur adipiscing elit.
                Quisque at neque mattis, malesuada velit vel, facilisis tortor.
            </Card>
            <Card eyebrow="02" title="Dolor sit">
                Lorem ipsum dolor sit amet, consectetur adipiscing elit.
                Quisque at neque mattis, malesuada velit vel, facilisis tortor.
            </Card>
            <Card eyebrow="03" title="Consectetur">
